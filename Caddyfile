:{$PORT:8080} {
	root * /srv
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	# film files are versioned (?v=<content hash>), so they can be cached for a long time
	@films path /f/*
	header @films Cache-Control "public, max-age=31536000, immutable"
	# the page itself must always be revalidated so visitors get the newest version
	@page not path /f/*
	header @page Cache-Control "no-cache"
	file_server
}
